{
  "name": "delivery-hub-management-system",
  "version": "1.0.0",
  "description": "Delivery Hub Management System - Course Project IT3180 (Software Engineering)",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/infrastructure/database/prisma/schema.prisma",
    "db:seed": "tsx src/infrastructure/database/prisma/seed.ts",
    "db:studio": "prisma studio --schema=src/infrastructure/database/prisma/schema.prisma",
    "test": "tsx --test tests/**/*.test.ts",
    "test:domain": "tsx --test tests/domain/*.test.ts",
    "test:infra": "tsx --test tests/infrastructure/*.test.ts",
    "verify": "node scripts/verify_loops.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
