# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION - DELIVERY HUB SYSTEM
# Copy this file to .env.production on your production server or VPS
# =============================================================================

# 1. Environment & Network Port
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 2. Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Docker Compose, the host is usually 'postgres' or the external cloud database host
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/delivery_hub?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=delivery_hub
POSTGRES_PORT=5434

# 3. Security & Authentication
# Generate a secure 64-character random string for production
JWT_SECRET=production_super_secret_jwt_key_please_change_in_production_9f8e7d6c5b4a
JWT_EXPIRES_IN=1d

# 4. Storage & Third-party Integrations (Cloudflare R2 / S3)
# Base URL for public access to uploaded proof-of-delivery images
CLOUDFLARE_R2_URL=https://r2.deliveryhub.example.com
